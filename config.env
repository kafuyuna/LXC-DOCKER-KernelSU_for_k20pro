# ============================================
# 内核源码配置
# ============================================
# 内核源码地址（使用 Antigravity 内核）
KERNEL_SOURCE=https://github.com/xiziphus/kernel_xiaomi_raphael_antigravity.git

# 内核源码分支
KERNEL_SOURCE_BRANCH=main

# 内核编译配置（K20 Pro 的 defconfig）
KERNEL_CONFIG=raphael_defconfig

# 内核打包名字，自定义，支持英文数字
KERNEL_ZIP_NAME=raphael_lxc-docker-kernel_202610161200

# ============================================
# 功能开关
# ============================================
# 是否开启 kvm
# 百分之90的用户用不到kvm，false即可
ENABLE_KVM=false

# 是否开启 lxc-docker，true 即可
ENABLE_LXC_DOCKER=true

# ============================================
# 内核镜像与编译选项
# ============================================
# 选择要打包的内核镜像文件
# K20 Pro (raphael) 需要 Image.gz-dtb
KERNEL_IMAGE_NAME=Image.gz-dtb

# 是否需要 LLVM=1 LLVM_IAS=1 参数
# 取决于你的内核源码，一般是需要的
# 需要填 y，不需要填 n
LLVM_CONFIG=y

# 是否需要切换 python2，一般不需要，false 即可
SWITCH_PYTHON=false

# 是否需要 dtbo，一般不需要，false 即可
NEED_DTBO=false

# ============================================
# KernelSU 配置
# ============================================
# 该内核已集成 KernelSU 代码，建议开启
# 如果需要 ksu，值改成 true，下面的参数 main 不用改
ENABLE_KERNELSU=true
KERNELSU_TAG=main
