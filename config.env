# ============================================
# 内核源码配置
# ============================================
# 内核源码地址（使用 SOVIET-ANDROID 内核）
KERNEL_SOURCE=https://github.com/SOVIET-ANDROID/kernel_xiaomi_raphael.git

# 内核源码分支 (此分支为 Android 11 适配)
KERNEL_SOURCE_BRANCH=dev/12.1

# 内核编译配置 (K20 Pro 的 defconfig)
KERNEL_CONFIG=raphael_defconfig

# 内核打包名字，自定义，支持英文数字
KERNEL_ZIP_NAME=raphael_lxc-docker-kernel_20261016

# ============================================
# 功能开关
# ============================================
# 是否开启 kvm
# 百分之90的用户用不到kvm，false即可
ENABLE_KVM=false

# 是否开启 lxc-docker，true 即可
ENABLE_LXC_DOCKER=true

# ============================================
# 内核镜像与编译选项
# ============================================
# 选择要打包的内核镜像文件
# K20 Pro (raphael) 需要 Image.gz-dtb
KERNEL_IMAGE_NAME=Image.gz-dtb

# 是否需要 LLVM=1 LLVM_IAS=1 参数
# 该内核使用 clang 编译，需要此参数
LLVM_CONFIG=y

# 是否需要切换 python2，一般不需要，false 即可
SWITCH_PYTHON=false

# 是否需要 dtbo，一般不需要，false 即可
NEED_DTBO=false

# ============================================
# KernelSU 配置
# ============================================
# 该内核原生支持 KernelSU，建议开启
ENABLE_KERNELSU=true
KERNELSU_TAG=main
